{
  "//": "Opciones comunes para compilar los paquetes publicables a dist/ (npm run build:lib).",
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "composite": true,
    "declaration": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "removeComments": false,
    "lib": ["ES2022", "DOM"],
    "types": []
  }
}
