# Copie este archivo a .env (no se versiona) y ajuste los valores.
# Sin DATABASE_URL la API arranca en modo memoria: /salud, /plantillas y
# POST /conciliaciones funcionan (sin guardar); el resto responde 503.
DATABASE_URL=postgres://usuario:clave@localhost:5432/conciliador
# Neon exige SSL: agregue ?sslmode=require a la URL.
# DATABASE_URL=postgres://usuario:clave@ep-ejemplo.neon.tech/conciliador?sslmode=require
PORT=3000
# Origen del panel permitido por CORS ('*' o lista separada por comas).
CORS_ORIGEN=*
# Solo para las pruebas: base de datos desechable.
# DATABASE_URL_PRUEBA=postgres://postgres@localhost:54329/postgres
