{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "node"
    ],
    "customConditions": [
      "conciliador-src"
    ]
  },
  "include": [
    "packages",
    "apps/api",
    "scripts"
  ],
  "exclude": [
    "**/node_modules",
    "**/dist"
  ]
}
