{
  "name": "@conciliador/excel",
  "version": "0.2.0",
  "description": "Adaptador de Excel (.xlsx/.xls) a filas para el conciliador. Mantiene el núcleo sin dependencias.",
  "keywords": [
    "conciliacion",
    "colombia",
    "pagos",
    "asobancaria",
    "wompi",
    "bre-b",
    "dian",
    "excel",
    "xlsx"
  ],
  "license": "MIT",
  "author": "Joan Mateo Cardona Lorza",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JoanMateo77/conciliador-algoritmos.git",
    "directory": "packages/excel"
  },
  "type": "module",
  "exports": {
    ".": {
      "conciliador-src": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
