{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node"],
    "paths": {
      "@conciliador/core": ["../../packages/core/src/index.ts"],
      "@conciliador/plantillas": ["../../packages/plantillas/index.ts"],
      "@conciliador/excel": ["../../packages/excel/src/index.ts"],
      "@conciliador/dian": ["../../packages/dian/src/index.ts"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
