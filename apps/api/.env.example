# Copie este archivo a .env (no se versiona) y ajuste los valores.
# Sin DATABASE_URL la API arranca en modo memoria: /salud, /plantillas y
# POST /conciliaciones funcionan (sin guardar); el resto responde 503.
DATABASE_URL=postgres://usuario:clave@localhost:5432/conciliador
# Neon exige SSL: agregue ?sslmode=require a la URL.
# DATABASE_URL=postgres://usuario:clave@ep-ejemplo.neon.tech/conciliador?sslmode=require
PORT=3000
# Origen del panel permitido por CORS ('*' o lista separada por comas).
CORS_ORIGEN=*

# ---------- Multiempresa (fase 12) ----------
# Secreto para firmar los JWT (HS256). Use un valor largo y aleatorio, por ejemplo:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# Si falta, la API usa uno temporal y los tokens dejan de valer al reiniciar.
JWT_SECRETO=cambie-este-valor-por-uno-aleatorio
# Duración de los tokens en segundos (8 horas por defecto).
# JWT_DURACION_S=28800
# 1 = tomar la IP del cliente de X-Forwarded-For (solo detrás de un proxy propio, como Render).
# CONFIAR_PROXY=0

# ---------- Cola y worker (fase 13) ----------
# Intentos máximos de cada trabajo antes de quedar 'fallido'.
# TRABAJO_MAX_INTENTOS=3
# Worker (npm run worker -w apps/api): trabajos a la vez y espera con la cola vacía.
# WORKER_CONCURRENCIA=1
# WORKER_INTERVALO_MS=1000
# Tope para terminar el trabajo en curso tras SIGTERM antes de salir.
# WORKER_APAGADO_MS=25000
# Registros JSON por línea: depurar | info | aviso | error | silencio.
# LOG_NIVEL=info
# Conexiones máximas del pool de PostgreSQL por proceso.
# PG_MAX_CONEXIONES=10

# Solo para las pruebas: base de datos desechable (las pruebas nuevas crean bases propias en ese servidor).
# DATABASE_URL_PRUEBA=postgres://postgres@localhost:54329/postgres
# Solo para scripts/carga.ts: base de pruebas donde encolar trabajos.
# CARGA_DATABASE_URL=postgres://postgres@localhost:54329/conciliador_carga
